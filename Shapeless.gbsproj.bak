                                "__collapseElse": false,
                                "__collapse": true
                            },
                            "children": {
                                "true": [
                                    {
                                        "command": "EVENT_TEXT",
                                        "args": {
                                            "text": [
                                                "Welcome young\nknigh. I was",
                                                "Awaiting your \narrival. Our",
                                                "Kingdom is in\ndanger, so I task",
                                                "you to save it \nfrom the ",
                                                "Lynx invasion. Use\nthe secret exit",
                                                "behind the rock in\nthe sword and bow",
                                                "training room, and\ndefeat the Lynx ",
                                                "army.Good luck,\nbrave knight !"
                                            ],
                                            "avatarId": "",
                                            "__collapse": true
                                        },
                                        "id": "dbbb85e1-9dfc-43d7-9aec-22a4ac0a438c"
