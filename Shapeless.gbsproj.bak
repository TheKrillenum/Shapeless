                                        {
                                            "command": "EVENT_TEXT",
                                            "args": {
                                                "text": [
                                                    "Thank you for your\nhelp kind hero !",
                                                    "As a reward for \ndefending our",
                                                    "Bunker, i will\ngive you the ",
                                                    "Duck stone ! It's \nthe symbol of our",
                                                    "country's might, \nbut be carefull !",
                                                    "Since the war \nstarted, the lynx",
                                                    "Put a curse on the\nstone to transform",
                                                    "nearby rocks into\nenemy Lynx, so",
                                                    "be aware of your \nsurroundings !"
                                                ],
                                                "avatarId": "",
                                                "__collapse": true
                                            },
                                            "id": "60dbc425-bda8-41c4-98e4-cc386f8d3a0b"
                                        }
