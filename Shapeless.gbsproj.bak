                                    {
                                        "command": "EVENT_TEXT",
                                        "args": {
                                            "text": [
                                                "Hey, welcome to \nthe Sword and bow",
                                                "training. Equip \nyour sword to ",
                                                "enable rapid slash",
                                                "The bow allow for\nlong range combat",
                                                "but shooting cost\narrows. Cut grass",
                                                "to find more \narrows.",
                                                "You can train on\nthat dummy there."
                                            ],
