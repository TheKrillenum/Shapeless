                                        },
                                        {
                                            "command": "EVENT_TEXT",
                                            "args": {
                                                "text": [
                                                    "Thank you for your\nhelp kind hero !",
                                                    "As a reward for \ndefending our",
                                                    "Bunker, i will\ngive you the ",
                                                    "Duck stone ! It's \nthe symbol of our",
                                                    "country's might, \nand proves that",
                                                    "you are now a true\nhero.",
                                                    "But beware ! To\nturn the tide of ",
                                                    "war the Lynx put a\ncurse on the stone",
                                                    "turning nearby \nrocks into enemy",
                                                    "Lynx, so be \ncarefull !"
                                                ],
                                                "avatarId": "",
                                                "__collapse": false
                                            },
                                            "id": "60dbc425-bda8-41c4-98e4-cc386f8d3a0b"
                                        }
                                    ],
