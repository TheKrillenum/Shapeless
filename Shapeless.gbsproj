                                "variable": "30",
                                "__collapseElse": false,
                                "__collapse": false
                            },
                            "children": {
                                "true": [
                                    {
                                        "command": "EVENT_TEXT",
                                        "args": {
                                            "text": [
                                                "Hey, welcome to \nthe Sword and bow",
                                                "training. Equip \nyour sword to ",
                                                "enable rapid slash",
                                                "The bow allow for\nlong range combat",
                                                "but shooting cost\narrows. Cut grass",
                                                "to find more \narrows.",
                                                "You can train on\nthat dummy there,",
                                                "here are 9 arrows\nfor you to train."
                                            ],
                                            "avatarId": "",
                                            "__collapse": false
                                        },
                                        "id": "cf2a78a6-acd9-4d69-a4a4-bf0e5eae82ba"
