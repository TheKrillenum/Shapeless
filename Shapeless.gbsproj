                {
                    "name": "",
                    "id": "3ca4e450-954c-420e-950c-49bae829e7b6",
                    "x": 31,
                    "y": 27,
                    "symbol": "trigger_16",
                    "width": 2,
                    "height": 1,
                    "script": [
                        {
                            "command": "EVENT_IF_FALSE",
                            "args": {
                                "variable": "32",
                                "__collapseElse": false,
                                "__collapse": false
                            },
                            "children": {
                                "true": [
                                    {
                                        "command": "EVENT_TEXT",
                                        "args": {
                                            "text": [
                                                "Welcome young\nknigh. I am King",
                                                "Duck and I was \nawaiting your",
                                                "arrival. Our\nKingdom is in",
                                                "great danger, so I\nmust task you",
                                                "with saving it \nfrom the Lynx",
                                                "invasion. To aid\nyou in your quest,",
                                                "I shall bless you\nwith my holy power",
                                                "so that for every\n3 enemies defeated",
                                                "you will heal. \nyourself. Use",
                                                "the secret exit \nbehind the rock in",
                                                "the sword and bow \ntraining room",
                                                "below you, and\ngo defeat the Lynx",
                                                "Emporor.Good luck,\nDuck knight !"
                                            ],
                                            "avatarId": "",
                                            "__collapse": false
                                        },
                                        "id": "dbbb85e1-9dfc-43d7-9aec-22a4ac0a438c"
                                    },
                                    {
                                        "command": "EVENT_SET_TRUE",
                                        "args": {
                                            "variable": "32",
                                            "__collapse": true
                                        },
                                        "id": "ea08d69c-5574-471f-bbb8-bc8f7de69c13"
                                    }
                                ],
                                "false": [
                                    {
                                        "command": "EVENT_TEXT",
                                        "args": {
                                            "text": [
                                                "Shall i repeat\nmyself ?"
                                            ],
                                            "avatarId": ""
                                        },
                                        "id": "8dbdbc4a-39b1-4d4d-a6b6-e67fe7aeb1fc"
                                    },
                                    {
                                        "command": "EVENT_CHOICE",
                                        "args": {
                                            "variable": "L0",
                                            "trueText": "Hum... yes ?",
                                            "falseText": "No your majesty."
                                        },
                                        "id": "df7ba666-e2c8-4b7f-aeb9-b365ac29d9f9"
                                    },
                                    {
                                        "command": "EVENT_IF_TRUE",
                                        "args": {
                                            "variable": "L0",
                                            "__collapseElse": false
                                        },
                                        "children": {
                                            "true": [
                                                {
                                                    "command": "EVENT_TEXT",
                                                    "args": {
                                                        "text": [
                                                            "I was awaiting \nyour arrival.",
                                                            "Our Kingdom is in\ndanger, so I task",
                                                            "you to save it \nfrom the ",
                                                            "Lynx invasion. Use\nthe secret exit",
                                                            "behind the rock in\nthe sword and bow",
                                                            "training room, and\ndefeat the Lynx ",
                                                            "army.Good luck,\nbrave knight !"
                                                        ],
                                                        "avatarId": "",
                                                        "__collapse": false
                                                    },
                                                    "id": "55a61ac0-d5c6-49e3-bf6b-8e62a8b39993"
                                                }
                                            ],
                                            "false": [
                                                {
                                                    "command": "EVENT_TEXT",
                                                    "args": {
                                                        "text": [
                                                            "Good luck,\nbrave knight !"
                                                        ],
                                                        "avatarId": ""
                                                    },
                                                    "id": "dcfe2e09-5676-42e4-97bb-10e71e272527"
                                                }
                                            ]
                                        },
                                        "id": "e7bca027-9844-4c25-9596-266dafa8cf3b"
                                    }
                                ]
                            },
                            "id": "0c46f48e-5624-4bb9-b6bd-257aaa6e8432"
                        }
                    ],
                    "leaveScript": []
                },
                {
                    "name": "",
                    "id": "45aca1eb-ffe3-498d-8cd4-adde068f35f0",
                    "x": 1,
                    "y": 33,
                    "symbol": "trigger_17",
                    "width": 4,
                    "height": 4,
                    "script": [
                        {
                            "command": "EVENT_IF_FALSE",
                            "args": {
                                "variable": "31",
                                "__collapseElse": false,
                                "__collapse": false
                            },
                            "children": {
                                "true": [
                                    {
                                        "command": "EVENT_TEXT",
                                        "args": {
                                            "text": [
                                                "Another knight in\ntraining, Ay ?",
                                                "You need to stay\nalive to win a ",
                                                "Fight. You can \nstun nearby enemy",
                                                "with the hammer's\nshockwave, but you",
                                                "cannot damage them\nwith it. If an ",
                                                "arrow come toward \nyou, use your ",
                                                "shield to block it",
                                                "Your shield is \nalso very usefull",
                                                "at pushing heavy\nobject around,",
                                                "like stones !"
                                            ],
                                            "avatarId": "",
                                            "__collapse": false
                                        },
                                        "id": "2d092e7f-afda-43fa-9c88-3859058251c4"
                                    },
                                    {
                                        "command": "EVENT_SET_TRUE",
                                        "args": {
                                            "variable": "31",
                                            "__collapse": false
                                        },
                                        "id": "34319f72-3385-4b84-858b-ef153cca1ba7"
                                    }
                                ],
                                "false": [
                                    {
                                        "command": "EVENT_TEXT",
                                        "args": {
                                            "text": [
                                                "Did you get all of \nthat ?"
                                            ],
                                            "avatarId": ""
                                        },
                                        "id": "82c1131f-35e1-40c5-83a5-6c706d7a8140"
                                    },
                                    {
                                        "command": "EVENT_CHOICE",
                                        "args": {
                                            "variable": "L0",
                                            "trueText": "Yes, sir !",
                                            "falseText": "Not really..."
                                        },
                                        "id": "1144f511-970a-49b1-9bd9-687dde7d9e07"
                                    },
                                    {
                                        "command": "EVENT_IF_TRUE",
                                        "args": {
                                            "variable": "L0",
                                            "__collapseElse": false
                                        },
                                        "children": {
                                            "true": [
                                                {
                                                    "command": "EVENT_TEXT",
                                                    "args": {
                                                        "text": [
                                                            "Then go and train"
                                                        ],
                                                        "avatarId": ""
                                                    },
                                                    "id": "0ddc0a5b-4fb9-42fa-ac0d-f2fb8d52236d"
                                                }
                                            ],
                                            "false": [
                                                {
                                                    "command": "EVENT_TEXT",
                                                    "args": {
                                                        "text": [
                                                            "You need to stay\nalive to win a ",
                                                            "Fight. You can \nstun nearby enemy",
                                                            "with the hammer's\nshockwave, but you",
                                                            "cannot damage them\nwith it. If an ",
                                                            "arrow come toward \nyou, use your ",
                                                            "shield to block it",
                                                            "Your shield is \nalso very usefull",
                                                            "at pushing heavy\nobject around,",
                                                            "like stones !"
                                                        ],
                                                        "avatarId": "",
                                                        "__collapse": false
                                                    },
                                                    "id": "08ccf658-500f-41df-9021-c7c9db0f07d9"
                                                }
                                            ]
                                        },
                                        "id": "cd2d3aca-11e2-4d44-a2ae-80840eea99f4"
                                    }
                                ]
                            },
                            "id": "61ad23d2-2614-4e6e-b8f5-5de63f3e6b27"
                        }
                    ],
